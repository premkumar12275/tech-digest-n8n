    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: \"openai/gpt-oss-120b\", messages: [{ role: \"user\", content: \"You are curating a daily tech news digest covering these topics: AI/ML, Software Engineering, Cloud/DevOps, Cybersecurity, Consumer Tech & Automotive. From the article list below, select the 4-5 most interesting and relevant items PER TOPIC (max 30 total), skipping anything irrelevant or low-quality. For each selected item, write a 1-2 sentence summary explaining why it matters. Return ONLY valid JSON, no markdown formatting, no commentary, in exactly this shape: [{\\\"topic\\\": \\\"...\\\", \\\"title\\\": \\\"...\\\", \\\"url\\\": \\\"...\\\", \\\"summary\\\": \\\"...\\\"}]\\n\\nArticles:\\n\" + $json.prompt_text }], temperature: 0.3, max_tokens:12000 }) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1872,
        -96
      ],
      "id": "b63d9ed1-2134-492a-a495-93a435e4b30a",
      "name": "LLM Summarize",
      "credentials": {
        "httpHeaderAuth": {
          "id": "qXflxHS6ilWovatZ",
          "name": "Header Auth groq"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "d0a51281-7617-4216-8521-d4e820305732",
              "name": "digest_items",
              "value": "={{ JSON.parse($json.choices[0].message.content) }}",
              "type": "array"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        2096,
        -96
      ],
      "id": "24bd60b8-da40-4340-9f2b-4fccf5939ca2",
      "name": "Parse Digest"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "40113a9a-11de-4f36-8999-6b9bfb304ec8",
              "name": "email_html",
              "value": "={{ (() => {\n  const items = $json.digest_items;\n  const allItems = $('Aggregate').first().json.items;\n  const topics = [...new Set(items.map(i => i.topic))];\n  let html = '<h1>Your Tech Digest</h1>';\n  for (const topic of topics) {\n    html += `<h2>${topic}</h2>`;\n    const topicItems = items.filter(i => i.topic === topic);\n    for (const item of topicItems) {\n      const match = allItems.find(a => a.url === item.url);\n      const img = (match && match.image_url)\n        ? `<img src=\"${match.image_url}\" style=\"width:100%;max-width:400px;height:180px;object-fit:cover;border-radius:6px;display:block;margin-bottom:8px;\" />`\n        : '';\n      html += `<div style=\"margin-bottom:20px;\">${img}<p><a href=\"${item.url}\"><strong>${item.title}</strong></a><br>${item.summary}</p></div>`;\n    }\n  }\n  return html;\n})() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        2320,
        -96
      ],
      "id": "8c698ee2-598a-43d0-8f27-53e21330b4d0",
      "name": "Build Email HTML"
